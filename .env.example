# Backend (copy to backend/.env)
DATABASE_URL=sqlite:///./vitapulse.db
# postgresql+psycopg://vitapulse:vitapulse@localhost:5432/vitapulse
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# AI coach (plan, scan, tips, chat). Leave empty to use the offline formulas and templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Google sign-in: create an OAuth client (Web) in Google Cloud Console and add the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3001
# Private uploads (progress photos)
MEDIA_DIR=./media

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
